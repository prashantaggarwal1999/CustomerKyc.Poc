<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TDESEncrypt</AssemblyName>
    <RootNamespace>TDESEncrypt</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Triple-DES encryption/decryption library — managed .NET assembly, Linux-compatible.</Description>
    <!-- Explicitly avoid any Windows-only dependencies -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
