<?xml version="1.0" encoding="utf-8" ?>
<!--
  app.config — read by System.Configuration.ConfigurationManager on startup.

  Purpose: Validate that System.Configuration.ConfigurationManager (v10.0.8)
  works on Linux. The runtime looks for {AssemblyName}.dll.config at the
  application base path. This file is copied as CustomerKyc.Api.dll.config.

  Verdict: FULLY COMPATIBLE on Linux — managed package, no Windows-only path.
  In a greenfield ASP.NET Core application, prefer IConfiguration / appsettings.json.
  This file exists only to satisfy POC requirement #11.
-->
<configuration>
  <appSettings>
    <add key="PocCompatibilityCheck" value="SystemConfigurationManager-Linux-OK" />
  </appSettings>
</configuration>
